# Watchlog configuration. Copy to .env and fill in.
#   cp .env.example .env
# .env is gitignored. Nothing in this file should ever hold a real value.

# ---------- Plex ----------
# Plex webhooks cannot send custom headers or basic auth, so the listener is
# protected by an unguessable path segment instead: /plex/<secret>
# Generate one with:  openssl rand -hex 16
PLEX_WEBHOOK_SECRET=change_me_random_hex

# Webhooks fire for other users on the server too. Only log events whose
# Account.title matches this.
PLEX_ACCOUNT_TITLE=your_plex_username

# Not needed for the webhook path. Only if we ever poll history as a backfill.
PLEX_TOKEN=

# Port the webhook listener binds on. LAN only, never forwarded.
WEBHOOK_PORT=8420

# ---------- Apple TV ----------
# The device's stable identifier from `atvremote scan` -- preferred over the IP,
# which can change. Ours is the "Living Room" Apple TV 4K.
ATV_IDENTIFIER=00000000-0000-0000-0000-000000000000

# Produced by pairing (`atvremote --id <id> --protocol companion pair`).
# Long opaque strings. These are credentials -- never commit them.
ATV_AIRPLAY_CREDENTIALS=
ATV_COMPANION_CREDENTIALS=

# ---------- TMDb (enrichment: title -> IMDb id + year) ----------
# Free key from https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# ---------- Publishing to NearlyFreeSpeech ----------
# NFSN assigns your datacenter; check the site's "Information" tab for the
# exact ssh hostname (ssh.phx..., ssh.lax..., etc).
NFSN_SSH_HOST=ssh.phx.nearlyfreespeech.net
NFSN_SSH_USER=youruser_yoursite
NFSN_REMOTE_PATH=/home/public/watchlog/

# Path on the Pi to the private key used for the unattended rsync.
# The key itself lives in ~/.ssh and NEVER enters this repo.
NFSN_SSH_KEY=/home/adam/.ssh/id_ed25519_nfsn

# ---------- Admin UI (the delete surface) ----------
# Binds to LAN/Tailnet only. The token is belt-and-braces on top of that.
ADMIN_PORT=8421
ADMIN_TOKEN=change_me_random_hex

# ---------- Local paths ----------
WATCHLOG_DB=/home/adam/watchlog/watchlog.db
WATCHLOG_OUT=/home/adam/watchlog/out/watchlog.html
