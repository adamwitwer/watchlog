[Unit]
Description=Watchlog admin (delete UI)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=adam
WorkingDirectory=/home/adam/Projects/watchlog
ExecStart=/home/adam/Projects/watchlog/venv/bin/python -m watchlog.admin
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
