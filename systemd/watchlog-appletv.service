[Unit]
Description=Watchlog Apple TV listener
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=adam
WorkingDirectory=/home/adam/Projects/watchlog
ExecStart=/home/adam/Projects/watchlog/venv/bin/python -m watchlog.appletv
Restart=always
RestartSec=15

[Install]
WantedBy=multi-user.target
