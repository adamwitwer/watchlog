[Unit]
Description=Watchlog backup to another machine
Documentation=https://github.com/adamwitwer/watchlog
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=adam
WorkingDirectory=/home/adam/Projects/watchlog
ExecStart=/home/adam/Projects/watchlog/venv/bin/python -m watchlog.backup
