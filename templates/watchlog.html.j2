<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Watchlog — Adam Witwer</title>
<meta name="description" content="What Adam Witwer has been watching.">
<style>
  :root {
    --bg: #fbfaf8;
    --fg: #16151a;
    --muted: #6d6a75;
    --rule: #e3e0da;
    --accent: #c2762a;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #131217;
      --fg: #f0eeea;
      --muted: #918d99;
      --rule: #2a2830;
      --accent: #fdb041;
    }
  }

  * { box-sizing: border-box; }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--fg);
    font-family: ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI",
                 Helvetica, Arial, sans-serif;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
    line-height: 1.5;
  }

  .wrap {
    max-width: 40rem;
    margin: 0 auto;
    padding: clamp(2.5rem, 8vw, 5.5rem) clamp(1.25rem, 5vw, 2rem) 6rem;
  }

  header { margin-bottom: clamp(2.5rem, 7vw, 4rem); }

  h1 {
    font-size: clamp(1.5rem, 4vw, 1.9rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    margin: 0 0 0.4rem;
  }

  .blurb {
    color: var(--muted);
    font-size: 0.95rem;
    margin: 0;
    max-width: 34rem;
  }

  .blurb a { color: var(--muted); text-decoration-color: var(--rule); }
  .blurb a:hover { color: var(--accent); }

  ol { list-style: none; margin: 0; padding: 0; }

  li {
    padding: clamp(1.4rem, 4vw, 1.9rem) 0;
    border-top: 1px solid var(--rule);
  }

  .title {
    font-size: clamp(1.45rem, 5vw, 2rem);
    font-weight: 600;
    letter-spacing: -0.022em;
    line-height: 1.2;
    margin: 0;
  }

  .title a {
    color: inherit;
    text-decoration: none;
    background-image: linear-gradient(var(--accent), var(--accent));
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 0% 1.5px;
    transition: background-size 0.25s ease, color 0.2s ease;
  }
  .title a:hover { color: var(--accent); background-size: 100% 1.5px; }

  .detail {
    font-size: clamp(1rem, 3vw, 1.1rem);
    font-weight: 400;
    color: var(--muted);
    letter-spacing: 0;
  }

  .epname {
    font-size: clamp(0.95rem, 2.6vw, 1.08rem);
    color: var(--muted);
    margin: 0.3rem 0 0;
    line-height: 1.35;
  }

  .meta {
    margin-top: 0.55rem;
    font-size: 0.76rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--muted);
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    align-items: baseline;
  }

  .meta .sep { opacity: 0.4; }
  .badge { color: var(--accent); }

  footer {
    margin-top: 4rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
    color: var(--muted);
    font-size: 0.8rem;
  }
  footer a { color: var(--muted); }
  footer a:hover { color: var(--accent); }

  .empty { color: var(--muted); font-size: 1.05rem; }

  /* --- search --------------------------------------------------------------
     Hidden in the markup and revealed by the script, so a browser with no
     JavaScript is never shown a box that cannot do anything. Everything else
     on this page still works without it. */
  .search { margin-top: 1.9rem; }
  .search[hidden] { display: none; }

  .search form {
    display: flex;
    align-items: baseline;
    gap: 0.85rem;
  }

  .search input {
    flex: 1 1 auto;
    min-width: 0;
    font: inherit;
    font-size: 0.95rem;
    color: var(--fg);
    background: transparent;
    border: 0;
    border-bottom: 1px solid var(--rule);
    border-radius: 0;
    padding: 0.35rem 0;
    appearance: none;
    -webkit-appearance: none;
    transition: border-color 0.18s ease;
  }
  .search input::placeholder { color: var(--muted); opacity: 1; }
  .search input:focus { outline: none; border-bottom-color: var(--accent); }
  .search input::-webkit-search-cancel-button { cursor: pointer; }

  .count {
    flex: 0 0 auto;
    font-size: 0.7rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  li.off { display: none; }

  /* --- timeline rail -------------------------------------------------------
     One hairline per entry, newest at the top, so a year of viewing reads as
     texture: the dense stretches are the busy weeks. Hovering a tick expands it
     and labels it with its date; clicking jumps to that entry. It is plain
     anchors and CSS; the only script that touches it is the search, which
     rebuilds it from the entries a query left standing.

     Only the first tick of each month is a tab stop. 150 tab stops before the
     content would be hostile, and the fine ticks are a pointer affordance for
     something the list already says in full. */
  /* Deliberately NOT scroll-behavior: smooth. The page is ~24,000px tall, so
     animating a jump from September to October scrolls through the whole year --
     slow, disorienting, and easily interrupted mid-flight, which strands you
     somewhere arbitrary. A scrubber should land, not travel. */
  li { scroll-margin-top: clamp(1.5rem, 5vw, 3rem); }

  .rail {
    position: fixed;
    top: 50%;
    right: clamp(0.5rem, 2.5vw, 2.25rem);
    transform: translateY(-50%);
    height: min(72vh, 40rem);
    width: 2.5rem;
    display: flex;
    flex-direction: column;
    z-index: 5;
    /* Deliberately not overflow: hidden. Both labels -- the hover tooltip and
       the mobile month abbreviations -- sit outside the rail to its left, so
       clipping the box erases them. Overflow is prevented instead by giving
       the ticks no minimum height: flex items with no floor always fit. */
  }

  .rail[hidden] { display: none; }

  .tick {
    flex: 1 1 0;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    position: relative;
    text-decoration: none;
  }

  .tick::before {
    content: "";
    width: 9px;
    height: 1.5px;
    border-radius: 1px;
    background: var(--rule);
    transition: width 0.18s ease, background-color 0.18s ease;
  }

  .tick--month::before { width: 17px; background: var(--muted); }

  .tick:hover::before,
  .tick:focus-visible::before { width: 30px; background: var(--accent); }

  /* The neighbours lift too, so the rail moves like a wave rather than one
     tick blinking on and off. */
  .tick:hover + .tick::before,
  .tick:has(+ .tick:hover)::before { width: 22px; background: var(--muted); }

  .tick-label {
    position: absolute;
    right: calc(100% + 0.5rem);
    white-space: nowrap;
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--fg);
    background: var(--bg);
    border: 1px solid var(--rule);
    border-radius: 5px;
    padding: 0.2rem 0.45rem;
    opacity: 0;
    transform: translateX(0.35rem);
    transition: opacity 0.16s ease, transform 0.16s ease;
    pointer-events: none;
  }

  .tick:hover .tick-label,
  .tick:focus-visible .tick-label,
  .tick:active .tick-label { opacity: 1; transform: none; }

  /* Where you landed, faintly, so a jump doesn't leave you hunting. */
  li:target { border-top-color: var(--accent); }

  /* Touch and narrow screens: no hover to reveal a label, and a 4px tick is
     not a tap target. Drop to one tick per month, spaced out enough to hit,
     and give the column room so the rail never sits on top of the text. */
  @media (max-width: 46rem), (hover: none) {
    /* The column has to clear the rail AND the month labels, which hang outside
       the rail to its left -- clearing only the rail's own width leaves the
       labels sitting on top of the text. The rail itself is narrowed to roughly
       the tick, since the rest of its width was empty space. */
    .wrap { padding-right: 4.4rem; }
    .rail { right: 0.5rem; width: 1.4rem; height: min(70vh, 34rem); }
    .tick:not(.tick--month) { display: none; }

    /* Spread the months over the rail so each is a real tap target rather
       than a 17px sliver, and label them: with no hover there is nothing
       else to tell one dash from another. */
    .tick--month { flex: 1 1 0; min-height: 2.4rem; }
    .tick--month::before { width: 10px; }
    .tick--month::after {
      content: attr(data-month);
      position: absolute;
      right: calc(100% + 0.35rem);
      font-size: 0.56rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--muted);
    }
    .tick-label { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .tick::before, .tick-label { transition: none; }
  }
</style>
</head>
<body>
<div class="wrap">

  <header>
    <h1>Watchlog</h1>
    <p class="blurb">
      What I've been watching, logged automatically from
      <a href="https://www.plex.tv">Plex</a> and the Apple TV.
    </p>

    {% if entries %}
    <div class="search" hidden>
      <form role="search">
        {# The placeholder is kept short enough to survive a 320px screen,
           where the column has to leave room for the rail as well. #}
        <input type="search" autocomplete="off" spellcheck="false"
               enterkeyhint="search" aria-label="Filter the log"
               placeholder="Filter &mdash; show, film, episode">
        <span class="count" aria-live="polite"></span>
      </form>
    </div>
    {% endif %}
  </header>

  {% if entries %}
  <ol>
    {% for entry in entries %}
    <li id="{{ entry.anchor }}" data-q="{{ entry.q }}"
        data-mkey="{{ entry.month_key }}" data-mon="{{ entry.month_short }}">
      <p class="title">
        {%- if entry.imdb_id %}
        <a href="https://www.imdb.com/title/{{ entry.imdb_id }}/">{{ entry.title }}</a>
        {%- else %}
        {{ entry.title }}
        {%- endif %}
        {%- if entry.detail %} <span class="detail">{{ entry.detail }}</span>{% endif %}
      </p>
      {% if entry.episode_names %}
      <p class="epname">{{ entry.episode_names }}</p>
      {% endif %}
      <p class="meta">
        <span>{{ entry.date_label }}</span>
        <span class="sep">/</span>
        <span class="badge">{{ entry.service }}</span>
        {%- if entry.year %}
        <span class="sep">/</span>
        <span>{{ entry.year }}</span>
        {%- endif %}
      </p>
    </li>
    {% endfor %}
  </ol>
  {% else %}
  <p class="empty">Nothing logged yet.</p>
  {% endif %}

  <nav class="rail" aria-label="Jump to a date">
    {% for entry in entries if entry.rail_tick %}
    <a class="tick{% if entry.month_start %} tick--month{% endif %}"
       href="#{{ entry.anchor }}"
       {% if entry.month_start %}data-month="{{ entry.month_short }}"{% else %}tabindex="-1"{% endif %}
       aria-label="{{ entry.date_label }}"><span class="tick-label">{{ entry.date_label }}</span></a>
    {% endfor %}
  </nav>

  <footer>
    Updated {{ generated_at }} ·
    <a href="https://github.com/adamwitwer/watchlog">source</a> ·
    <a href="/">adamwitwer.com</a>
  </footer>

</div>
{% if entries %}
<script>
/* Filter the log as you type. Every entry is already in the page, so this is
   one substring test per row per keystroke -- no index, no debounce, no fetch,
   and nothing to go stale.

   The typed query is folded exactly the way render.py folded each row's
   data-q. The two have to agree; see search_normalize() over there. */
(function () {
  var box = document.querySelector('.search');
  var list = document.querySelector('ol');
  if (!box || !list) return;

  var input = box.querySelector('input');
  var count = box.querySelector('.count');
  var rows = Array.prototype.slice.call(list.children);
  var rail = document.querySelector('.rail');
  var fullRail = rail ? rail.innerHTML : '';

  function fold(text) {
    return text.toLowerCase()
      .normalize('NFKD').replace(/[̀-ͯ]/g, '')
      .replace(/['’]/g, '')
      .replace(/[^a-z0-9]+/g, ' ')
      .trim();
  }

  /* Every word has to appear somewhere in the row, in any order, so
     "severance milchick" finds the night without knowing how the line reads. */
  function matches(row, words) {
    for (var i = 0; i < words.length; i++) {
      if (row.dataset.q.indexOf(words[i]) === -1) return false;
    }
    return true;
  }

  /* A filtered rail can't reuse the ticks that were rendered: they are thinned
     to one in N of the whole log, and most of the survivors are now hidden.
     Rebuild it instead -- one tick per month, pointing at that month's topmost
     surviving entry. Below two months there is nothing to scrub between, so
     the rail leaves rather than standing full-height beside four results. */
  function rebuildRail(visible) {
    var frag = document.createDocumentFragment();
    var last = null;
    var months = 0;

    visible.forEach(function (row) {
      if (row.dataset.mkey === last) return;
      last = row.dataset.mkey;
      months++;

      var date = row.querySelector('.meta span');
      date = date ? date.textContent : row.dataset.mon;

      var tick = document.createElement('a');
      tick.className = 'tick tick--month';
      tick.href = '#' + row.id;
      tick.setAttribute('data-month', row.dataset.mon);
      tick.setAttribute('aria-label', date);

      var label = document.createElement('span');
      label.className = 'tick-label';
      label.textContent = date;
      tick.appendChild(label);
      frag.appendChild(tick);
    });

    rail.textContent = '';
    rail.hidden = months < 2;
    if (!rail.hidden) rail.appendChild(frag);
  }

  function apply() {
    var words = fold(input.value).split(' ').filter(Boolean);
    var visible = [];

    rows.forEach(function (row) {
      var hit = !words.length || matches(row, words);
      row.classList.toggle('off', !hit);
      if (hit) visible.push(row);
    });

    if (!words.length) {
      count.textContent = '';
      if (rail) { rail.innerHTML = fullRail; rail.hidden = false; }
      return;
    }

    count.textContent = visible.length
      ? visible.length + ' of ' + rows.length
      : 'no matches';
    if (rail) rebuildRail(visible);
  }

  /* One input and no button means Enter would submit the form and reload the
     page, throwing away the filter it was meant to confirm. */
  box.querySelector('form').addEventListener('submit', function (event) {
    event.preventDefault();
  });

  input.addEventListener('input', apply);
  input.addEventListener('keydown', function (event) {
    if (event.key === 'Escape' && input.value) {
      input.value = '';
      apply();
    }
  });

  /* "/" to search, the way it works most other places. */
  document.addEventListener('keydown', function (event) {
    if (event.key !== '/' || event.metaKey || event.ctrlKey || event.altKey) return;
    if (document.activeElement === input) return;
    event.preventDefault();
    input.focus();
    box.scrollIntoView({ block: 'center' });
  });

  box.hidden = false;
})();
</script>
{% endif %}
</body>
</html>
