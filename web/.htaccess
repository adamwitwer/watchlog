# Watchlog republishes whenever something is watched, so the edge cache must
# not hold a stale page. Without this, NearlyFreeSpeech served the previous
# version for 15+ minutes after a successful publish.
#
# Both modules are tried: mod_headers alone did not take effect on this host.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 60 seconds"
  ExpiresByType text/html "access plus 60 seconds"
</IfModule>
<IfModule mod_headers.c>
  Header set Cache-Control "public, max-age=60, must-revalidate"
</IfModule>
